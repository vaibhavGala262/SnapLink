# Copy this file to ".env" (same directory as pom.xml) and fill in your values.
# ⚠️ .env is git-ignored — never commit real credentials.

# ===== PostgreSQL (required) =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=snaplink
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change-me

# ===== Caching / healthy indicators =====
# Not used in the "lite" profile (SPRING_PROFILES_ACTIVE=lite); Redis only for the default profile.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TIMEOUT=2000ms
REDIS_HEALTH_ENABLED=true

# ===== Kafka =====
# Only used in the default profile. Start Kafka via `docker compose up kafka`, or use lite profile.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ===== App behaviour =====
# Base used when building the returned short link, e.g. http://localhost:8080/
# If unset, the request scheme+host is used automatically.
PREFIX_WEBSITE_DOMAIN=http://localhost:8080/

# ===== Optional: GeoIP database =====
# If set, points GeoIPService at an external GeoLite2-City.mmdb.
# Otherwise the app looks for src/main/resources/GeoLite2-City.mmdb (git-ignored).
# GEOIP_DB_PATH=/path/to/GeoLite2-City.mmdb